name: approval-timeout

# 운영 승인 요청이 60분 안에 처리되지 않은 deploy 실행을 취소하고 Slack에 알린다 (T6 · T9).
# 본문은 one-tatchi-platform의 재사용 워크플로이고, 여기서는 시간만 넘긴다. 취소된 배포를 다시 올리려면 deploy를 main에서 수동 실행한다.
on:
  schedule:
    - cron: "*/15 * * * *"
  workflow_dispatch:
    inputs:
      dry-run:
        description: 취소하지 않고 대상만 적는다
        type: boolean
        default: false

permissions:
  actions: write
  contents: read

jobs:
  reap:
    uses: SoftBank-Hackathon-2026-Team-Amethyst/one-tatchi-platform/.github/workflows/approval-timeout.yml@@@TEMPLATE_VERSION@@
    with:
      template-ref: @@TEMPLATE_VERSION@@
      max-wait-minutes: 60
      dry-run: ${{ inputs.dry-run || false }}
    secrets: inherit
