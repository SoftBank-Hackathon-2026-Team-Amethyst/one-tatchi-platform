# AWS 루트. state 버킷 · CI 역할 · DNS 존은 bootstrap(platform)에서 관리한다. 플랫폼 모듈을 태그로 참조한다.
terraform {
  required_version = ">= 1.11"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    helm = {
      source  = "hashicorp/helm"
      version = "~> 3.0"
    }
    # [if DB_LINK]
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.38"
    }
    # [end]
  }

  # bucket은 워크플로가 -backend-config로 넣는다 (vars.TF_STATE_BUCKET).
  backend "s3" {
    key          = "@@APP@@/aws.tfstate"
    region       = "ap-northeast-2"
    use_lockfile = true
    encrypt      = true
  }
}

provider "aws" {
  region              = var.region
  allowed_account_ids = [var.account_id]

  default_tags {
    tags = { Project = "one-tatchi", ManagedBy = "terraform", Stack = var.service }
  }
}

data "aws_caller_identity" "current" {}

# bootstrap의 CI 역할을 재사용한다.
data "aws_iam_role" "plan" {
  name = "one-tatchi-gha-plan"
}

data "aws_iam_role" "deploy" {
  name = "one-tatchi-gha-deploy"
}

# EKS access entry에는 STS 세션이 아닌 IAM 역할 ARN이 필요하다.
data "aws_iam_roles" "team_administrators" {
  name_regex  = "^AWSReservedSSO_AdministratorAccess_.*$"
  path_prefix = "/aws-reserved/sso.amazonaws.com/${var.region}/"
}

data "aws_route53_zone" "service" {
  count        = var.domain_name == "" ? 0 : 1
  name         = var.domain_name
  private_zone = false
}

module "network" {
  source = "git::https://github.com/SoftBank-Hackathon-2026-Team-Amethyst/one-tatchi-platform.git//modules/network/aws?ref=@@TEMPLATE_VERSION@@"

  name       = var.name
  cidr       = "10.0.0.0/16"
  az_count   = 2
  single_nat = true
}

module "cluster" {
  source = "git::https://github.com/SoftBank-Hackathon-2026-Team-Amethyst/one-tatchi-platform.git//modules/cluster/aws?ref=@@TEMPLATE_VERSION@@"

  name                = var.name
  kubernetes_version  = var.kubernetes_version
  network_id          = module.network.network_id
  subnet_ids          = module.network.private_subnet_ids
  node_instance_types = var.node_instance_types
  node_count          = var.node_count

  admin_principal_arns = distinct(concat(
    [data.aws_iam_role.deploy.arn],
    sort(tolist(data.aws_iam_roles.team_administrators.arns)),
    var.additional_admin_principal_arns,
  ))
  viewer_principal_arns = [data.aws_iam_role.plan.arn]
}

provider "helm" {
  kubernetes = {
    host                   = module.cluster.endpoint
    cluster_ca_certificate = base64decode(module.cluster.ca_certificate)
    exec = {
      api_version = "client.authentication.k8s.io/v1beta1"
      command     = "aws"
      args        = ["eks", "get-token", "--cluster-name", module.cluster.cluster_name, "--region", var.region]
    }
  }
}
# [if DB_LINK]

# db_link 모듈의 Service 리소스용. helm provider와 같은 exec 인증.
provider "kubernetes" {
  host                   = module.cluster.endpoint
  cluster_ca_certificate = base64decode(module.cluster.ca_certificate)
  exec {
    api_version = "client.authentication.k8s.io/v1beta1"
    command     = "aws"
    args        = ["eks", "get-token", "--cluster-name", module.cluster.cluster_name, "--region", var.region]
  }
}
# [end]

module "registry" {
  source = "git::https://github.com/SoftBank-Hackathon-2026-Team-Amethyst/one-tatchi-platform.git//modules/registry/aws?ref=@@TEMPLATE_VERSION@@"

  repositories = var.repositories
}

# [if !NO_RDS]
module "database" {
  source = "git::https://github.com/SoftBank-Hackathon-2026-Team-Amethyst/one-tatchi-platform.git//modules/database/aws?ref=@@TEMPLATE_VERSION@@"

  name                       = "${var.service}-db"
  database_name              = var.database_name
  engine_version             = "17"
  instance_class             = var.db_instance_class
  storage_gb                 = 20
  multi_az                   = false
  network_id                 = module.network.network_id
  subnet_ids                 = module.network.private_subnet_ids
  allowed_security_group_ids = [module.cluster.node_security_group_id]
}
# [end]

module "cluster_addons" {
  source = "git::https://github.com/SoftBank-Hackathon-2026-Team-Amethyst/one-tatchi-platform.git//modules/cluster_addons/aws?ref=@@TEMPLATE_VERSION@@"

  cluster_name         = module.cluster.cluster_name
  region               = var.region
  network_id           = module.network.network_id
  # [if !DB_LINK]
  readable_secret_arns = [module.database.credentials_secret_id]
  # [end]
  # [if DB_LINK]
  readable_secret_arns = local.readable_secret_arns
  # [end]
  dns_zone_id          = var.domain_name == "" ? "" : data.aws_route53_zone.service[0].zone_id
}

module "observability" {
  source = "git::https://github.com/SoftBank-Hackathon-2026-Team-Amethyst/one-tatchi-platform.git//modules/observability/aws?ref=@@TEMPLATE_VERSION@@"

  cluster_name  = module.cluster.cluster_name
  region        = var.region
  ingress_class = module.cluster_addons.ingress_class
  ingress_group = var.service
}

# 환경별 네임스페이스와 DB 접속 Secret(cloud-secrets → <service>-db). 앱은 deploy.yml이 이 네임스페이스에 올린다.
# test · prod가 같은 RDS를 쓴다.
resource "helm_release" "service_base" {
  for_each = toset(var.environments)

  name       = "${var.service}-base-${each.key}"
  namespace  = "default"
  repository = "oci://ghcr.io/softbank-hackathon-2026-team-amethyst/charts"
  chart      = "service-base"
  version    = var.chart_version

  values = [yamlencode({
    namespace   = each.key
    secretStore = module.cluster_addons.secret_store_name
    # [if !DB_LINK]
    database = {
      secretName = "${var.service}-db"
      remoteKey  = module.database.credentials_secret_id
      host       = module.database.host
      port       = module.database.port
      name       = module.database.database_name
    }
    # [end]
    # [if DB_LINK]
    # db_link에 적힌 환경은 온프레미스 DB(tailnet 통로)를, 나머지는 RDS를 쓴다. Secret 키 · 형식은 같다 (ADR 0016 · 0017 · 0018).
    database = lookup(local.linked_databases, each.key, local.rds_database)
    # [end]
  })]
}
# [if DB_LINK]

# ---------- 계층별 배포 위치 (T32, ADR 0018): DB는 온프레미스, 통로는 db_link (T33, ADR 0017) ----------
# 온프레미스 DB의 username/password JSON과 Tailscale OAuth는 Secrets Manager에 사람이 넣는다(콘솔 · CLI).
# Terraform은 이름 · ARN만 읽고, 값은 External Secrets가 클러스터로 가져간다. state에 평문이 남지 않는다.
locals {
  # [if !NO_RDS]
  rds_database = {
    secretName = "${var.service}-db"
    remoteKey  = module.database.credentials_secret_id
    host       = module.database.host
    port       = module.database.port
    name       = module.database.database_name
  }
  # [end]
  # [if NO_RDS]
  rds_database = null # 모든 환경이 온프레미스 DB를 쓴다 (plan.yaml database_scope 생략)
  # [end]
  readable_secret_arns = concat(
    # [if !NO_RDS]
    [module.database.credentials_secret_id],
    # [end]
    [for s in data.aws_secretsmanager_secret.tailscale_oauth : s.arn],
    [for s in data.aws_secretsmanager_secret.db_link : s.arn],
  )
  linked_databases = {
    for env, link in var.db_link : env => {
      secretName = "${var.service}-db"
      remoteKey  = data.aws_secretsmanager_secret.db_link[env].name
      host       = module.db_link[0].consumed[env].host
      port       = module.db_link[0].consumed[env].port
      name       = coalesce(link.database_name, var.database_name)
    }
  }
}

# count는 demo-app에 먼저 손으로 넣은 연결(T33)과 같은 리소스 주소를 쓰기 위한 것이다. 다시 렌더해도 재생성되지 않는다.
data "aws_secretsmanager_secret" "tailscale_oauth" {
  count = length(var.db_link) > 0 ? 1 : 0
  name  = var.tailscale_oauth_secret_name
}

data "aws_secretsmanager_secret" "db_link" {
  for_each = var.db_link
  name     = each.value.secret_name
}

# 네임스페이스 tailscale과 operator-oauth Secret(cloud-secrets → client_id · client_secret)
resource "helm_release" "tailscale_base" {
  count = length(var.db_link) > 0 ? 1 : 0

  name       = "tailscale-base"
  namespace  = "default"
  repository = "oci://ghcr.io/softbank-hackathon-2026-team-amethyst/charts"
  chart      = "service-base"
  version    = var.chart_version

  values = [yamlencode({
    namespace   = "tailscale"
    secretStore = module.cluster_addons.secret_store_name
    secret = {
      secretName = "operator-oauth"
      remoteKey  = var.tailscale_oauth_secret_name
    }
  })]
}

module "db_link" {
  source = "git::https://github.com/SoftBank-Hackathon-2026-Team-Amethyst/one-tatchi-platform.git//modules/db_link/tailscale?ref=@@TEMPLATE_VERSION@@"
  count  = length(var.db_link) > 0 ? 1 : 0

  cluster_name           = var.name
  tailnet                = var.tailnet
  create_oauth_secret    = false # tailscale_base가 External Secrets로 만든다
  manage_namespace       = false
  operator_chart_version = var.tailscale_operator_chart_version

  consume = {
    for env, link in var.db_link : env => {
      namespace = env
      name      = "${var.service}-db-onprem"
      fqdn      = link.fqdn
    }
  }

  depends_on = [helm_release.tailscale_base]
}
# [end]
