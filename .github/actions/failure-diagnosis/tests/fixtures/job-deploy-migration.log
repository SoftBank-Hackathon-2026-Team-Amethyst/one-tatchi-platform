2026-10-10T17:10:26.9883395Z [36;1m[0m
2026-10-10T17:10:26.9883623Z [36;1m# 2단계: green 대기 · 주소는 서비스마다 따로 기다린다. helm upgrade를 먼저 모두 보내 두어[0m
2026-10-10T17:10:26.9883938Z [36;1m# 서비스들의 green 기동이 겹친다 (T9: 직렬이면 서비스당 green 기동 시간이 그대로 더해졌다).[0m
2026-10-10T17:10:26.9884293Z [36;1m# 적용 순서(BE 먼저)는 1단계가 지키고, Blue-Green이라 green FE는 active BE를 보므로 순서가 결과를 바꾸지 않는다.[0m
2026-10-10T17:10:26.9884611Z [36;1mfor idx in $(seq 0 $((count - 1))); do[0m
2026-10-10T17:10:26.9884873Z [36;1m  svc="$(jq -c ".[$idx]" <<<"$SERVICES")"[0m
2026-10-10T17:10:26.9885124Z [36;1m  release="$(jq -r .name <<<"$svc")"[0m
2026-10-10T17:10:26.9885375Z [36;1m  echo "::group::$release green 대기"[0m
2026-10-10T17:10:26.9885613Z [36;1m  wait_rollout "$release"[0m
2026-10-10T17:10:26.9885893Z [36;1m  service_urls "$release" "$(jq -r .values <<<"$svc")"[0m
2026-10-10T17:10:26.9886159Z [36;1m  echo "::endgroup::"[0m
2026-10-10T17:10:26.9886358Z [36;1m[0m
2026-10-10T17:10:26.9886599Z [36;1m  [ -z "$first_active" ] && [ -n "$active" ] && first_active="$active"[0m
2026-10-10T17:10:26.9887011Z [36;1m  slack+="*$release* active (blue): ${active:-(외부 주소 없음)} · preview (green): $preview"$'\n'[0m
2026-10-10T17:10:26.9887499Z [36;1m  echo "- **$release** active (blue): ${active:-(외부 주소 없음)} · preview (green): $preview" >> "$GITHUB_STEP_SUMMARY"[0m
2026-10-10T17:10:26.9887867Z [36;1mdone[0m
2026-10-10T17:10:26.9888025Z [36;1m[0m
2026-10-10T17:10:26.9888187Z [36;1m{[0m
2026-10-10T17:10:26.9888514Z [36;1m  echo "active=$first_active"[0m
2026-10-10T17:10:26.9888815Z [36;1m  echo "names=$(jq -r 'map(.name) | join(" ")' <<<"$SERVICES")"[0m
2026-10-10T17:10:26.9889112Z [36;1m  echo "paused=${paused% }"[0m
2026-10-10T17:10:26.9889383Z [36;1m  echo "slack<<END"; printf '%s' "$slack"; echo "END"[0m
2026-10-10T17:10:26.9889658Z [36;1m} >> "$GITHUB_OUTPUT"[0m
